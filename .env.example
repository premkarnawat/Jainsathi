# ========================================================
# JAINSAATHI PRODUCTION ENVIRONMENT CONFIGURATION
# ========================================================

# Supabase Public Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Private Service Role Key (SERVER ONLY - NEVER EXPOSE TO BROWSER)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Razorpay Gateway Integration
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_SECRET=your_razorpay_private_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Application Host URL
NEXT_PUBLIC_APP_URL=https://jainsaathi.com
